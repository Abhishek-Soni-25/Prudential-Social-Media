# Copy to .env and fill in. NEVER commit .env.

# --- AI core (REQUIRED) — Groq, model llama-3.3-70b-versatile ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- (legacy) Gemini — optional, not used by the current pipeline ---
GEMINI_API_KEY=

# Live Reddit/LinkedIn data comes from the n8n webhook (config.yaml -> n8n) — no key needed.
# The variables below are only needed if you switch a channel to a real live connector.

# --- Telegram (MTProto) ---
# Obtain api_id / api_hash at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=                 # login phone, e.g. +6591234567 (interactive code on first run)

# --- Reddit ---
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-media-surveillance/0.1 by your_reddit_username

# --- X / Twitter API v2 (paid tier required for search) ---
X_BEARER_TOKEN=

# --- LinkedIn (ToS-GATED unofficial scraper) ---
# WARNING: the linkedin-api library logs in with a real account and VIOLATES LinkedIn's
# User Agreement (account-ban + legal risk). Prefer a licensed provider. To enable anyway:
#   pip install linkedin-api   AND set linkedin channel to mode: live in config.yaml
LINKEDIN_TOS_ACK=false          # set to "true" to acknowledge the ToS/legal risk
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
# (Compliant alternative) consented compliance-archive vendor feed:
LINKEDIN_ARCHIVE_ENDPOINT=
LINKEDIN_ARCHIVE_TOKEN=

# --- WhatsApp (authorized compliance-archive feed only) ---
WHATSAPP_ARCHIVE_ENDPOINT=
WHATSAPP_ARCHIVE_TOKEN=

# --- Quora (no API; licensed social-listening provider feed only) ---
QUORA_FEED_ENDPOINT=
QUORA_FEED_TOKEN=
